# initialization
/run/initialize

# optimization
/run/setCut 1.0 mm

/run/eventModulo 1 # NOTE: Fixes a wierd bug, otherwise beamcount is tied to threadcount and there is thread lock or something

# verbosity
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/control/verbose 0

# Progress
/run/printProgress 50

# execution
/run/beamOn 500 # NOTE: Should be multiples of 8 (number of cores)

